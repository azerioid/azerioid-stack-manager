{
  "id": "nginx",
  "display_name": "Nginx",
  "category": "web",
  "description": "Internal backend engine (loopback only). Caddy terminates TLS on :80/:443 and reverse-proxies vhosts that choose Nginx.",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": {
    "ubuntu": "24.04",
    "debian": "12",
    "el": "9"
  },
  "ports": [
    {
      "port": 8082,
      "bind": "127.0.0.1",
      "owner": "nginx",
      "protocol": "tcp"
    }
  ],
  "conflicts": [],
  "distros": {
    "ubuntu": {
      "packages": [
        "nginx"
      ],
      "unit_name": "nginx",
      "detect": {
        "packages": [
          "nginx"
        ],
        "unit": "nginx",
        "command": "nginx -v"
      },
      "paths": {
        "vhost_dir": "/etc/nginx/sites-enabled",
        "vhost_available": "/etc/nginx/sites-available",
        "web_log_dir": "/var/log/nginx"
      }
    },
    "debian": {
      "packages": [
        "nginx"
      ],
      "unit_name": "nginx",
      "detect": {
        "packages": [
          "nginx"
        ],
        "unit": "nginx",
        "command": "nginx -v"
      },
      "paths": {
        "vhost_dir": "/etc/nginx/sites-enabled",
        "vhost_available": "/etc/nginx/sites-available",
        "web_log_dir": "/var/log/nginx"
      }
    },
    "el": {
      "packages": [
        "nginx"
      ],
      "unit_name": "nginx",
      "detect": {
        "packages": [
          "nginx"
        ],
        "unit": "nginx",
        "command": "nginx -v"
      },
      "paths": {
        "vhost_dir": "/etc/nginx/conf.d",
        "vhost_available": "/etc/nginx/conf.d",
        "web_log_dir": "/var/log/nginx"
      }
    }
  },
  "preflight": {
    "min_disk_gb": 1,
    "min_ram_mb": 512
  }
}
