{
  "id": "nodejs",
  "display_name": "Node.js (system)",
  "category": "runtime",
  "description": "One host-wide Node.js from NodeSource at /usr/bin/node (the \"system\" choice for PM2 vhosts). To run several majors side by side, install Node.js 20/22/24 instead.",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": { "ubuntu": "24.04", "debian": "12", "el": "9" },
  "ports": [],
  "conflicts": [],
  "install_options": {
    "node_major": { "default": "22", "choices": ["20", "22", "24"] }
  },
  "distros": {
    "ubuntu": {
      "packages": ["nodejs"],
      "unit_name": "",
      "detect": { "packages": ["nodejs"], "unit": "", "command": "node --version" }
    },
    "debian": {
      "packages": ["nodejs"],
      "unit_name": "",
      "detect": { "packages": ["nodejs"], "unit": "", "command": "node --version" }
    },
    "el": {
      "packages": ["nodejs"],
      "unit_name": "",
      "detect": { "packages": ["nodejs"], "unit": "", "command": "node --version" }
    }
  },
  "preflight": { "min_disk_gb": 0.5, "min_ram_mb": 256 }
}
