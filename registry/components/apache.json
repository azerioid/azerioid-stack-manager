{
  "id": "apache",
  "display_name": "Apache httpd",
  "category": "web",
  "description": "Internal backend engine (loopback only). Caddy terminates TLS on :80/:443 and reverse-proxies vhosts that choose Apache.",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": { "ubuntu": "24.04", "debian": "12", "el": "9" },
  "ports": [
    { "port": 8081, "bind": "127.0.0.1", "owner": "apache", "protocol": "tcp" }
  ],
  "conflicts": [],
  "distros": {
    "ubuntu": {
      "packages": ["apache2", "libapache2-mod-fcgid"],
      "unit_name": "apache2",
      "detect": { "packages": ["apache2"], "unit": "apache2", "command": "apache2 -v" }
    },
    "debian": {
      "packages": ["apache2", "libapache2-mod-fcgid"],
      "unit_name": "apache2",
      "detect": { "packages": ["apache2"], "unit": "apache2", "command": "apache2 -v" }
    },
    "el": {
      "packages": ["httpd", "mod_fcgid"],
      "unit_name": "httpd",
      "detect": { "packages": ["httpd"], "unit": "httpd", "command": "httpd -v" }
    }
  },
  "preflight": { "min_disk_gb": 1, "min_ram_mb": 512 }
}
