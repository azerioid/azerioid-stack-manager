{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stack-manager.local/registry/schema.json",
  "title": "AZERIOID Stack Manager Component",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "category",
    "description",
    "managed",
    "system",
    "min_os",
    "ports",
    "conflicts",
    "distros"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "web",
        "runtime",
        "php",
        "database",
        "cache",
        "process-manager",
        "mail",
        "tool",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "managed": {
      "type": "boolean"
    },
    "system": {
      "type": "boolean"
    },
    "min_os": {
      "type": "object",
      "properties": {
        "ubuntu": {
          "type": "string"
        },
        "debian": {
          "type": "string"
        },
        "el": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "port",
          "bind",
          "owner",
          "protocol"
        ],
        "properties": {
          "port": {
            "type": "integer"
          },
          "bind": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distros": {
      "type": "object",
      "properties": {
        "debian": {
          "$ref": "#/$defs/distro"
        },
        "ubuntu": {
          "$ref": "#/$defs/distro"
        },
        "el": {
          "$ref": "#/$defs/distro"
        }
      }
    },
    "preflight": {
      "type": "object",
      "properties": {
        "min_disk_gb": {
          "type": "number"
        },
        "min_ram_mb": {
          "type": "integer"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_physical_ram_mb": {
          "type": "integer",
          "description": "Hard minimum of physical RAM (MemTotal); swap is not counted. For JVM services (ADR A54)."
        }
      },
      "additionalProperties": false
    },
    "installable": {
      "type": "boolean",
      "description": "Offered on the Components page. System components (caddy, panel PHP) omit it."
    },
    "install_options": {
      "type": "object",
      "description": "Operator-selectable install options, e.g. node_major.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "default": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "description": "Downloaded artifact rather than a distro package (Adminer).",
      "additionalProperties": true
    }
  },
  "$defs": {
    "distro": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unit_name": {
          "type": "string"
        },
        "detect": {
          "type": "object",
          "properties": {
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unit": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "package_regex": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "repo": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "gpg_fingerprint": {
              "type": "string"
            },
            "keyring": {
              "type": "string"
            },
            "signed_by": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "post_install": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selinux": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "units": {
          "type": "object",
          "description": "Role => systemd unit, for components owning several units (mail: postfix/dovecot/opendkim).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "repos_hint": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra repositories required, e.g. epel for OpenDKIM on EL (A36)."
        },
        "foreign_mta_packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Conflicting MTAs removed only after typed REPLACE-MTA (A36)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
