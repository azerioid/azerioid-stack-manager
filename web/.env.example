APP_NAME="AZERIOID Stack Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# Installer overwrites APP_URL with the chosen --port (default 3169).
APP_URL=http://127.0.0.1:3169

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Dedicated panel database — SQLite in production bootstrap.
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/azerioid-panel/panel.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_EXPIRE_ON_CLOSE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Production: sudo the single broker binary. Local Mac: fake.
BROKER_DRIVER=sudo
BROKER_PATH=/usr/local/lib/azerioid-panel/broker
BROKER_USE_SUDO=true
BROKER_SUDO_PATH=/usr/bin/sudo
BROKER_TIMEOUT=45

AZERIOID_WWW_ROOT=/data/www
AZERIOID_SESSION_IDLE=15

# Installer writes this from --require-totp. Public default true; tunnel default false.
PANEL_REQUIRE_TOTP=false
TRUSTED_PROXIES=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="stack-manager@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
