{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_response.filePath // .tool_input.file_path // empty\"); case \"$f\" in */broker/src/*) rsync -a --delete \"$CLAUDE_PROJECT_DIR/broker/src/\" \"$CLAUDE_PROJECT_DIR/web/lib/azerioid-broker/\";; esac",
            "timeout": 30,
            "statusMessage": "Syncing broker/src → web/lib/azerioid-broker"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"$CLAUDE_PROJECT_DIR/broker/src\" ] && [ -d \"$CLAUDE_PROJECT_DIR/web/lib/azerioid-broker\" ] && rsync -a --delete \"$CLAUDE_PROJECT_DIR/broker/src/\" \"$CLAUDE_PROJECT_DIR/web/lib/azerioid-broker/\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
