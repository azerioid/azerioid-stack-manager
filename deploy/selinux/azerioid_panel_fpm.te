module azerioid_panel_fpm 1.0;

# Caddy on EL is httpd_t. Panel PHP-FPM is unconfined_service_t (bin_t copy).
# Without connectto, php_fastcgi gets EACCES (often dontaudit) and the UI 502s.

require {
    type httpd_t;
    type unconfined_service_t;
    type httpd_var_run_t;
    type var_run_t;
    class unix_stream_socket connectto;
    class sock_file { write getattr open };
}

allow httpd_t unconfined_service_t:unix_stream_socket connectto;
allow httpd_t httpd_var_run_t:sock_file { write getattr open };
allow httpd_t var_run_t:sock_file { write getattr open };
