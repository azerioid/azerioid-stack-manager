# Example: public domain mode (Let's Encrypt). Preferred for public access.
# ./stack-manager.sh --access=public --domain=panel.example.com --port=3169 --email=you@example.com
#
# Optional allowlist:
#   @blocked not remote_ip 203.0.113.0/24
#   respond @blocked "Forbidden" 403

https://panel.example.com:3169 {
    encode gzip zstd
    root * /usr/local/lib/azerioid-panel/web/public
    php_fastcgi unix//run/php/azerioid-panel.sock
    file_server
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }
    log {
        output file /var/log/caddy/azerioid-panel.log
    }
}
