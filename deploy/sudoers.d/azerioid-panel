# AZERIOID Stack Manager — sudoers
#
# The web worker (caddy) may run ONLY this broker, as root, with no password.
# Never add wildcards, never allow /bin/systemctl.
#
# Only settings both sudo and sudo-rs accept (A86) — CI validates this file under each.
#
# Validate: visudo -c -f /etc/sudoers.d/azerioid-panel
Defaults:caddy umask=0022
caddy ALL=(root) NOPASSWD: /usr/local/lib/azerioid-panel/broker
